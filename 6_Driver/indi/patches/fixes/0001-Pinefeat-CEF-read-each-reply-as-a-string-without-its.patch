From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: captain <captain@lcars.local>
Date: Mon, 19 Oct 2026 18:54:26 +0200
Subject: [PATCH 1/9] Pinefeat CEF: read each reply as a string without its
 line end

tty_nread_section() keeps the delimiter in the buffer and writes no
terminating zero when the reply fills the buffer. sendCommand() handed
the raw bytes over, which gave three defects:

- A reply of 15 characters and its '\n' fill CEF_BUF (16 bytes) with no
  terminating zero: strstr(), sscanf(), setText() and the log read past
  the buffer.
- The line end is kept in the texts shown to the user: FIRMWARE_VERSION
  reads "1.3\n", and so do FOCUS_DISTANCE, RANGE_APERTURE and the log
  ("Detected firmware version 1.3\n.").
- ERR_NC() tested strcmp(res, "nc") > 0, true for "nc\n" only because
  of its line end, and also for any reply sorting after "nc" (anything
  starting with 'o' to 'z', "nd"...), logged as "lens is not attached"
  in place of its own text.

sendCommand() now replaces the line end ('\n', and a '\r' before it)
with the terminating zero, within CEF_BUF, and ERR_NC() compares the
whole reply with "nc".
---
 drivers/focuser/pinefeat_cef.cpp | 7 ++++++-
 drivers/focuser/pinefeat_cef.h   | 5 +++--
 2 files changed, 9 insertions(+), 3 deletions(-)

diff --git a/drivers/focuser/pinefeat_cef.cpp b/drivers/focuser/pinefeat_cef.cpp
index 8ba29fe..1b0e095 100644
--- a/drivers/focuser/pinefeat_cef.cpp
+++ b/drivers/focuser/pinefeat_cef.cpp
@@ -28,7 +28,7 @@
 #include <termios.h>
 #include <thread>
 
-#define ERR_NC(res) (strcmp(res, "nc") > 0 ? "lens is not attached" : res)
+#define ERR_NC(res) (strcmp(res, "nc") == 0 ? "lens is not attached" : res)
 
 static std::unique_ptr<PinefeatCEF> pinefeatCEF(new PinefeatCEF());
 
@@ -520,6 +520,11 @@ bool PinefeatCEF::sendCommand(const char * cmd, char * res)
         return false;
     }
 
+    // The reply as a string, without its line end: tty_nread_section keeps the delimiter, and writes no
+    // terminating zero when the reply fills CEF_BUF
+    while (nbytes_read > 0 && (res[nbytes_read - 1] == CEF_DEL || res[nbytes_read - 1] == '\r'))
+        res[--nbytes_read] = '\0';
+
     LOGF_DEBUG("RES <%s>", res);
 
     tcflush(PortFD, TCIOFLUSH);
diff --git a/drivers/focuser/pinefeat_cef.h b/drivers/focuser/pinefeat_cef.h
index 4d99784..b4c1919 100644
--- a/drivers/focuser/pinefeat_cef.h
+++ b/drivers/focuser/pinefeat_cef.h
@@ -62,8 +62,9 @@ class PinefeatCEF : public INDI::Focuser
         /**
          * @brief sendCommand Send a string command to the controller.
          * @param cmd Command to be sent, must already have the necessary delimiter ('\n')
-         * @param res If not nullptr, the function will read until it detects the default delimiter ('\n') up to CEF_RES length.
-         *        if nullptr, no read back is done and the function returns true.
+         * @param res If not nullptr, the function will read until it detects the default delimiter ('\n') up to
+         *        CEF_BUF length, and returns the reply as a string, without its line end. If nullptr, no read back is
+         *        done and the function returns true.
          * @return True if successful, false otherwise.
          */
         bool sendCommand(const char * cmd, char * res = nullptr);
