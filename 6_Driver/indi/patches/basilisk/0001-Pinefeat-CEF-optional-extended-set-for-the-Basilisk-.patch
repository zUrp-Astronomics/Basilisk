+// Extended set, `q`
+bool PinefeatCEF::AbortFocuser()
+{
+    // Without ext=1, a focuser that can't abort, as INDI::Focuser makes it: no `q`
+    if (!ext)
+        return INDI::Focuser::AbortFocuser();
+
+    char res[EXT_BUF] = {0};
+    if (!sendCommand("q\n", res, EXT_BUF))
+        return false;
+
+    if (!strstr(res, "ok"))
+    {
+        LOGF_ERROR("Can't abort: %s.", res);
+        return false;
+    }
+
+    return true;
+}
